{
  "name": "agiliza-network",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev --concurrency=15",
    "dev:web": "turbo run dev --filter=@agiliza/web",
    "dev:pdf": "turbo run dev --filter=@agiliza/pdf",
    "dev:media": "turbo run dev --filter=@agiliza/media",
    "dev:calc": "turbo run dev --filter=@agiliza/calc",
    "dev:qr": "turbo run dev --filter=@agiliza/qr",
    "dev:bio": "turbo run dev --filter=@agiliza/bio",
    "dev:nota": "turbo run dev --filter=@agiliza/nota",
    "dev:img": "turbo run dev --filter=@agiliza/img",
    "dev:text": "turbo run dev --filter=@agiliza/text",
    "dev:dev": "turbo run dev --filter=@agiliza/dev",
    "dev:sign": "turbo run dev --filter=@agiliza/sign",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@agiliza/web",
    "build:pdf": "turbo run build --filter=@agiliza/pdf",
    "build:qr": "turbo run build --filter=@agiliza/qr",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "node scripts/clean.js",
    "clean:turbo": "node scripts/clean.js --turbo-only",
    "setup": "node scripts/setup-apps.js",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
